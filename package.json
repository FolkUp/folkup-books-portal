{
  "name": "folkup-books-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 + Vite + vite-ssg portal для 7-book Agile Sapiens series (books.folkup.life). CLDESIGN-007 target stack aligned. Content pipeline: Иви .adoc → asciidoctor.js build-time → Vue components → CF Pages.",
  "license": "MIT",
  "homepage": "https://books.folkup.life",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FolkUp/folkup-books-portal.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--experimental-require-module vite-ssg build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/visual/",
    "lint": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write .",
    "tokens:build": "style-dictionary build --config tokens/config.json",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@unhead/vue": "^2.0.0",
    "@vueuse/head": "^2.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@intlify/unplugin-vue-i18n": "^6.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "asciidoctor": "^3.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.10.6",
    "js-yaml": "^4.1.0",
    "prettier": "^3.4.0",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
